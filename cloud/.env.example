# G4CARE Cloud — production environment. Copy to `.env` and edit the secrets.
#   cp .env.example .env
# Then: docker compose up --build

# JWT signing secret — generate with:  openssl rand -hex 32
G4CARE_CLOUD_JWT_SECRET=change-me-in-production

# PostgreSQL (the backend connects as user `g4care`)
POSTGRES_PASSWORD=g4care

# S3 (SeaweedFS) credentials — must match seaweedfs-s3.json
G4CARE_CLOUD_S3_ACCESS_KEY=g4care
G4CARE_CLOUD_S3_SECRET_KEY=g4care-secret
G4CARE_CLOUD_S3_BUCKET=g4care

# SMTP for verification emails (any SMTP server, e.g. STARTTLS on :587).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=change-me
SMTP_FROM=noreply@g4care.cloud
